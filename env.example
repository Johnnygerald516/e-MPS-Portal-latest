# ============================================
# CENTRALIZED API CONFIGURATION
# ============================================
# This is the SINGLE SOURCE OF TRUTH for API configuration
# Copy this file to .env and update the values

# API Base URL - REQUIRED
# This is used throughout the entire application
# Examples:
#   Development: http://localhost:3300
#   Production:  https://api.yourdomain.com
#   Internal:    http://10.252.0.4:3300
NEXT_PUBLIC_API_URL=http://10.252.0.4:3300

# API Key (optional)
NEXT_PUBLIC_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=3001
NODE_ENV=production

# Image Domains (comma-separated)
NEXT_PUBLIC_IMAGE_DOMAINS=10.6.0.168

# Trusted Hostnames (comma-separated, optional)
NEXT_PUBLIC_TRUSTED_HOSTNAMES=localhost,127.0.0.1,10.6.0.168

# ============================================
# APPLICATION VERSION CONTROL
# ============================================
# Application version displayed in footer
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_NAME=eMPS Portal
NEXT_PUBLIC_BUILD_DATE=2026-03-29
